# Copy to .env and fill in server-side service settings.
# User accounts and human chat work without Band.
# Each user optionally enters their own band_u_ key at signup or in People
# to create/manage native Band agents. Runtime agent keys (band_a_) are saved separately.
# There is no shared BAND_USER_API_KEY fallback. Native Band human chat is coming soon.

# Optional OpenAI bootstrap key. Existing installations import it once.
# Admins select reasoning, document and image services independently in Providers & APIs.
OPENAI_API_KEY=

# Signs login sessions and encrypts the agent keys Band issues. Use a long random string.
APP_SECRET=change-me-to-a-long-random-string

# Optional overrides
# DEFAULT_MODEL=gpt-6-luna
# DOCUMENTS_PATH=/absolute/path/to/documents
# DATABASE_URL=sqlite:///./band_slack.db
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Durable Deep Agents worker (run separately with uv run python -m app.worker)
# Keep this file and DATABASE_URL on persistent local storage shared by API and worker.
# AGENT_CHECKPOINT_PATH=/absolute/path/to/agent_checkpoints.db
# AGENT_TASK_TIMEOUT=900
# AGENT_RECURSION_LIMIT=100

# Exa web research: create a key at https://dashboard.exa.ai/api-keys.
# Without this, agents report search as unavailable.
EXA_API_KEY=

# Composio project key (ak_…) for Plugins: Gmail, Slack, GitHub, and the rest.
# Create one at https://dashboard.composio.dev under Settings → API Keys.
# Without this, Plugins stays visible and Connect is unavailable.
COMPOSIO_API_KEY=

# Quick calculations run in OpenAI's hosted Code Interpreter sandbox instead of an E2B computer.
# FAST_CODE_EXECUTION=on

# How many visible teammates agents may create on their own with create_teammate.
# MAX_AGENT_TEAMMATES=10

# Optional USD per million tokens per model, for cost estimates next to token usage.
# Cache rates must be configured explicitly; otherwise ordinary input pricing is used.
# MODEL_PRICES={"MODEL_ID": {"input": 1.0, "output": 1.0}}  # replace with actual current rates

# E2B full cloud desktop, one isolated microVM per agent and channel.
# Create a key at https://e2b.dev/dashboard and keep it on the server only.
E2B_API_KEY=
# Live server apps use an isolated random subdomain on this API listener.
# Local Chromium resolves *.localhost. Production needs wildcard DNS/TLS for a dedicated domain.
# APP_PREVIEW_BASE_URL=http://localhost:8000
# Official desktop template includes XFCE, Chromium, terminal, and noVNC.
# E2B_DESKTOP_TEMPLATE=desktop
# Runtime fallback after a crash; automatically pauses instead of deleting files.
# Keep above AGENT_TASK_TIMEOUT; capped at 3600 seconds for the Hobby runtime limit.
# E2B_TIMEOUT_SECONDS=1200
# Paused computers persist until explicitly deleted in the E2B dashboard.

# Hosted installs without a durable disk can keep uploads and checkpoints in PostgreSQL:
# DOCUMENTS_PATH=database
# AGENT_CHECKPOINT_PATH=postgresql://user:password@host:5432/band

# Optional persistent Tenki computers; E2B remains available during migration.
# COMPUTER_PROVIDER=e2b
# TENKI_API_KEY=
# TENKI_DESKTOP_IMAGE=snapshot:<clean-image-id>
# TENKI_COMPUTER_SHARING=user # One private VM and disk per user; independent agent desktops.
# TENKI_DISK_GIB=1
# TENKI_TIMEOUT_SECONDS=1200
# TENKI_PAUSE_RETENTION_SECONDS=604800
# TENKI_LIFECYCLE_TIMEOUT_SECONDS=180
# See docs/tenki-computers.md for selection, retention and rollback.

# Add agents → Codex / Claude Agent / Cursor / OpenClaw stores credentials encrypted in the app database.
# Install Codex on BOTH the API/worker host: npm install -g @openai/codex
# Claude and Cursor Agent SDKs are installed by uv sync --locked; personal CLI history is not imported.
# Exact OpenClaw Gateway base URLs approved for server-side connections (comma-separated).
# HTTPS is required except for explicit loopback URLs. See docs/connected-agents.md for Gateway setup.
# OPENCLAW_GATEWAY_URLS=http://127.0.0.1:18789
# CODEX_EXECUTABLE=codex
# Local Codex browser sign-in uses its app-server and port 1455; no flag is required.
# The browser and API must run on the same computer. Hosted/paid apps need provider approval.
# Optional separate Sign in with ChatGPT client integration (not the native Codex login).
# CODEX_CHATGPT_SIGN_IN=on
# Run the API on this listener before starting browser sign-in. Do not substitute localhost for 127.0.0.1.
# AGENT_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Optional: compatible model endpoint origins allowed to use HTTP/private networks.
# Public HTTPS endpoints need no entry. Never allow metadata/link-local endpoints.
PROVIDER_ENDPOINT_ALLOWLIST=
