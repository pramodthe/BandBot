# Copy to .env and fill in. These are org-wide: nobody pastes per-agent keys.

# Your Band organization's user API key (starts with band_u_).
# Create it at https://app.band.ai/users/settings -> API Keys -> Create API Key.
# The app uses it to register agents, create a Band room per channel, and post humans' messages.
BAND_USER_API_KEY=

# OpenAI key used by agents, file analysis, retrieval, and Python data analysis.
# Admins can also configure an encrypted key in workspace settings.
OPENAI_API_KEY=

# Signs login sessions and encrypts the agent keys Band issues. Use a long random string.
APP_SECRET=change-me-to-a-long-random-string

# Optional overrides
# MASTER_AGENT_NAME=Master
# DEFAULT_MODEL=gpt-6-luna
# DOCUMENTS_PATH=/absolute/path/to/documents
# BAND_POLL_SECONDS=5
# DATABASE_URL=sqlite:///./band_slack.db
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Durable Deep Agents worker (run separately with uv run python -m app.worker)
# Keep this file and DATABASE_URL on persistent local storage shared by API and worker.
# AGENT_CHECKPOINT_PATH=/absolute/path/to/agent_checkpoints.db
# AGENT_TASK_TIMEOUT=900
# AGENT_RECURSION_LIMIT=100

# Exa web research: create a key at https://dashboard.exa.ai/api-keys.
# Without this, agents report search as unavailable.
EXA_API_KEY=

# Composio project key (ak_…) for Plugins: Gmail, Slack, GitHub, and the rest.
# Create one at https://dashboard.composio.dev under Settings → API Keys.
# Without this, Plugins stays visible and Connect is unavailable.
COMPOSIO_API_KEY=

# Quick calculations run in OpenAI's hosted Code Interpreter sandbox instead of an E2B computer.
# FAST_CODE_EXECUTION=on

# How many visible teammates agents may create on their own with create_teammate.
# MAX_AGENT_TEAMMATES=10

# Optional USD per million tokens per model, for cost estimates next to token usage.
# Cache rates must be configured explicitly; otherwise ordinary input pricing is used.
# MODEL_PRICES={"MODEL_ID": {"input": 1.0, "output": 1.0}}  # replace with actual current rates

# E2B full cloud desktop, one isolated microVM per agent and channel.
# Create a key at https://e2b.dev/dashboard and keep it on the server only.
E2B_API_KEY=
# Live server apps use an isolated random subdomain on this API listener.
# Local Chromium resolves *.localhost. Production needs wildcard DNS/TLS for a dedicated domain.
# APP_PREVIEW_BASE_URL=http://localhost:8000
# Official desktop template includes XFCE, Chromium, terminal, and noVNC.
# E2B_DESKTOP_TEMPLATE=desktop
# Runtime fallback after a crash; automatically pauses instead of deleting files.
# Keep above AGENT_TASK_TIMEOUT; capped at 3600 seconds for the Hobby runtime limit.
# E2B_TIMEOUT_SECONDS=1200
# Paused computers persist until explicitly deleted in the E2B dashboard.
